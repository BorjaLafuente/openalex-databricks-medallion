{
  "datasets": [
    {
      "name": "a796ab8c",
      "displayName": "output_by_year",
      "queryLines": [
        "   SELECT university, year, articles_reviews, conference_papers, total\r\n",
        "   FROM workspace.openalex.gold_output_by_year"
      ]
    },
    {
      "name": "f54c6bf5",
      "displayName": "open_access",
      "queryLines": [
        "SELECT university, year, pct_oa\r\n",
        "FROM workspace.openalex.gold_open_access"
      ]
    },
    {
      "name": "8cdd4e8c",
      "displayName": "open_access_routes",
      "queryLines": [
        "SELECT university, year, route, pct\r\n",
        "FROM workspace.openalex.gold_open_access\r\n",
        "UNPIVOT (\r\n",
        "  pct FOR route IN (\r\n",
        "    pct_gold    AS gold,\r\n",
        "    pct_diamond AS diamond,\r\n",
        "    pct_hybrid  AS hybrid,\r\n",
        "    pct_bronze  AS bronze,\r\n",
        "    pct_green   AS green,\r\n",
        "    pct_closed  AS closed\r\n",
        "  )\r\n",
        ")"
      ]
    },
    {
      "name": "541455da",
      "displayName": "international_collaboration",
      "queryLines": [
        "SELECT university, year, pct_int_art_rev\r\n",
        "FROM workspace.openalex.gold_international_collaboration"
      ]
    },
    {
      "name": "7e627b60",
      "displayName": "citation_impact",
      "queryLines": [
        "SELECT university, year, n_works, median_fwci, pct_top10\r\n",
        "FROM workspace.openalex.gold_citation_impact"
      ]
    },
    {
      "name": "0c0bcb77",
      "displayName": "galician_collaboration",
      "queryLines": [
        "SELECT uni_a || '–' || uni_b AS pair, year, n_shared\r\n",
        "FROM workspace.openalex.gold_galician_collaboration"
      ]
    }
  ],
